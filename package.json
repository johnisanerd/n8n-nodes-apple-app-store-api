{
	"name": "n8n-nodes-apple-app-store-api",
	"version": "0.1.1",
	"description": "n8n community node for the Apple App Store: get reviews, search results, and app details as JSON across 50+ country stores. Apify-backed, pay-per-use.",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"apple",
		"app-store",
		"app-store-reviews",
		"ios",
		"macos",
		"reviews",
		"ratings",
		"aso",
		"app-search",
		"app-metadata",
		"apify",
		"sentiment",
		"ai-tool"
	],
	"license": "MIT",
	"homepage": "https://github.com/johnisanerd/n8n-nodes-apple-app-store-api",
	"author": {
		"name": "John Cole",
		"email": "tirade.charge_4v@icloud.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/johnisanerd/n8n-nodes-apple-app-store-api.git"
	},
	"bugs": {
		"url": "https://github.com/johnisanerd/n8n-nodes-apple-app-store-api/issues"
	},
	"engines": {
		"node": ">=20.15"
	},
	"main": "index.js",
	"scripts": {
		"build": "n8n-node build",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"prepublishOnly": "n8n-node build"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"credentials": [
			"dist/credentials/ApifyApi.credentials.js",
			"dist/credentials/ApifyOAuth2Api.credentials.js"
		],
		"nodes": [
			"dist/nodes/AppleAppStore/AppleAppStore.node.js"
		]
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	},
	"devDependencies": {
		"@n8n/node-cli": "0.32.1",
		"@types/node": "^24.0.1",
		"eslint": "9.29.0",
		"prettier": "^3.6.2",
		"typescript": "5.9.2"
	}
}
